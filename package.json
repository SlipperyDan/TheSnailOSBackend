{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node server.js",
    "build": "vite build && npm run build:server && npm run build:electron",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --outfile=server.js --external:express --external:vite --external:dotenv",
    "build:electron": "esbuild src/electron/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-electron/main.js --external:electron",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http-get://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "start:electron": "NODE_ENV=production electron .",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.0.5"
  }
}
